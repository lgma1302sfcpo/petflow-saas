    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.102.8",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "^4.24.15",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
